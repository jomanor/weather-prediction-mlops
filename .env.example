# Copy to .env (gitignored) and fill in. Nothing here is a real secret.
#
# Where the values belong:
#  - local dev:   this file's copy (.env at the repo root); MONGO_URI may point at
#                 Atlas (real data, what the operators use) or at the
#                 docker-compose mongo (offline).
#  - production:  render.yaml + the Render dashboard for the API, the Netlify UI
#                 for the frontend. No .env file ships to production.

# Database name the app uses (compose's mongo init reads the same key).
MONGO_DB=weather_db

# Connection string. Atlas example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/weather_db?retryWrites=true&w=majority
# Local docker-compose example:
#   mongodb://admin:change-me@localhost:27017/weather_db?authSource=admin
# Never `source` this file: the password usually contains `&`.
MONGO_URI=mongodb://admin:change-me@localhost:27017/weather_db?authSource=admin

# Local mongo credentials, used by docker-compose's mongodb service only.
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me

# AEMET open-data key (benchmark/observations). Leave empty to disable AEMET.
AEMET_API_KEY=

# Enables POST/DELETE /cities. Unset or empty = writes disabled (503).
# CITY_WRITES_TOKEN=

# Optional MLflow tracking URI; MLflow is a lazy, opt-in side channel.
# MLFLOW_TRACKING_URI=
